# ── Aplicação ────────────────────────────────────────────────────────────────
# Obrigatória. Sem ela a aplicação recusa subir quando DEBUG=False.
SECRET_KEY=troque-isto
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Banco ────────────────────────────────────────────────────────────────────
# Neon exige SSL: use a connection string com sslmode=require.
#
# ⚠️ Dois papéis, de propósito (ADR-045):
#
#   DATABASE_URL           → `hamilton_web`. É o papel da aplicação. Não tem BYPASSRLS, e
#                            não tem permissão nenhuma em tabela clínica. É o que faz o
#                            Row-Level Security valer de verdade.
#   DATABASE_URL_MIGRACAO  → o papel **dono**. Só para `manage.py migrate`, que precisa de DDL.
#                            Nunca serve requisição.
#
# Apontar a aplicação para o dono desfaz a terceira camada da ADR-001 inteira — `core/checks.py`
# recusa o arranque se isso acontecer com DEBUG=False.
#
# A senha de `hamilton_web` é definida fora do repositório, uma vez, depois da primeira migração:
#   ALTER ROLE hamilton_web LOGIN PASSWORD 'a-senha';
DATABASE_URL=postgresql://hamilton_web:senha@host.neon.tech/hamilton?sslmode=require
DATABASE_URL_MIGRACAO=postgresql://hamilton_owner:senha@host.neon.tech/hamilton?sslmode=require

# ── WhatsApp (lembretes, ADR-144) ────────────────────────────────────────────
# DESLIGADO por padrão: sem WHATSAPP_ATIVO=True + token + phone id, o sistema roda em **modo simulado**
# (registra "enviaria", não chama a Meta). Ligue só quando a conta Meta tiver cartão (sem ele, erro 131042).
# Os valores secretos vêm do Paulo por gerenciador de senhas — nunca por commit. Detalhes em WHATSAPP.md.
WHATSAPP_ATIVO=False
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1413166918549157
WHATSAPP_WABA_ID=1068509042871904
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v26.0
# Segredo que o cron externo manda no cabeçalho X-Cron-Segredo ao bater em /lembretes/disparar/.
# Vazio = rota desligada. Gere com: openssl rand -hex 24
WHATSAPP_CRON_SEGREDO=
